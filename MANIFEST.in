include README.md
include README.zh-CN.md
include LICENSE
include Makefile
include pyproject.toml
include setup.py

recursive-include haplokit *.py
recursive-include deps/gffsub/src *.cpp *.hpp
recursive-include deps/gffsub *.md LICENSE Makefile
recursive-include deps/nlohmann *.hpp
recursive-include deps/htslib *
recursive-include src/cpp *.cpp *.h
recursive-include src/cpp/third_party *.hpp
recursive-include tests/cpp *.cpp
recursive-include tests/python *.py
recursive-include data *
recursive-include .github/workflows *.yml

# Submodules are vendored into the sdist as plain sources. Their .git entry
# is a file pointing at the superproject, not a directory, so prune alone
# does not drop it.
exclude deps/htslib/.git
exclude deps/htslib/htscodecs/.git
exclude deps/gffsub/.git
